{
  "name": "pi-codex-replica",
  "version": "0.1.0",
  "description": "Codex-style commands and tools for Pi coding agent.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "codex",
    "pi-extension"
  ],
  "files": [
    "extensions",
    "themes",
    "skills",
    "docs",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build:extensions": "node scripts/build-extensions.mjs",
    "prepare": "npm run build:extensions"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@types/node": "^20.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "esbuild": "^0.28.0",
    "jimp": "^1.6.1",
    "qrcode-terminal": "^0.12.0"
  }
}
