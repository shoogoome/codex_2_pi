{
  "name": "pi-codex-replica",
  "version": "0.1.0",
  "description": "Codex-style commands and tools for Pi coding agent.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "codex", "pi-extension"],
  "files": ["extensions", "README.md", "package.json"],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "extensions/diff",
      "extensions/review",
      "extensions/user-input",
      "extensions/subagents",
      "extensions/init"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.1",
    "@earendil-works/pi-tui": "^0.74.2",
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
